{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current file",
      "type": "shell",
      "command": "if [[ '${fileExtname}' == '.sql' ]]; then .venv/bin/python run_sql.py '${file}'; else .venv/bin/python '${file}'; fi",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}